{
  "include": [
    "src/worker.ts", "src/*.d.ts", "src/routeTree.gen.ts",
    "src/routes/**/*.ts", "src/routes/**/*.tsx", "src/business/**/*.ts",
    "src/features/business/**/*.ts", "src/features/business/**/*.tsx",
    "src/features/pilot/**/*.ts", "src/mcp/**/*.ts", "oauth/src/**/*.ts",
    "widget/*.ts", "widget/*.tsx", "*.config.ts", "worker-configuration.d.ts"
  ],
  "exclude": ["node_modules", "dist"],
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "paths": {
      "@/*": ["./src/*"],
      "collections/*": ["./.source/*"]
    },
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [
        "./worker-configuration.d.ts",
        "node",
        "vite/client"
    ],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  }
}
