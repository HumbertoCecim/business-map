{
  "name": "business-map-cloud",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.1",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "node widget/build.mjs && vite build",
    "preview": "pnpm build && vite preview",
    "test": "pnpm test:business && pnpm test:pilot && pnpm test:mcp && pnpm test:widget",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "typecheck": "fumadocs-mdx && tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "deploy:staging": "node scripts/deploy-business.mjs staging",
    "deploy:prod": "node scripts/deploy-business.mjs production",
    "cf-typegen": "wrangler types",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:staging": "wrangler d1 migrations apply business-map-cloud-staging --env staging --remote",
    "db:migrate:prod": "wrangler d1 migrations apply business-map-cloud-production --env production --remote",
    "db:seed:local": "wrangler d1 execute flarestarter-db --local --file=./scripts/seed.sql",
    "db:reset:local": "rm -rf .wrangler/state/v3/d1 && pnpm db:migrate:local && pnpm db:seed:local",
    "build:widget": "node widget/build.mjs",
    "typecheck:cloud": "tsc --noEmit",
    "test:business": "vitest run --config vitest.business.config.ts",
    "test:pilot": "vitest run --config vitest.pilot.config.ts",
    "test:mcp": "vitest run --config vitest.mcp.config.ts",
    "test:widget": "vitest run --project node src/features/business/widget-transport.node.test.ts src/features/business/map-presentation.node.test.ts",
    "test:ui": "playwright test --config widget/playwright.config.ts"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^1.26.0",
    "@orama/stopwords": "^3.1.18",
    "@orama/tokenizers": "^3.1.18",
    "@radix-ui/react-avatar": "^1.2.0",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-label": "^2.1.10",
    "@radix-ui/react-popover": "^1.1.17",
    "@radix-ui/react-slot": "^1.3.0",
    "@sentry/cloudflare": "^10.60.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-start": "latest",
    "better-auth": "^1.6.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "fumadocs-core": "^16.10.6",
    "fumadocs-mdx": "^15.0.13",
    "fumadocs-ui": "^16.10.6",
    "lucide-react": "1.73.0",
    "react": "19.3.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.3.0",
    "resend": "^6.12.4",
    "sonner": "^2.0.7",
    "stripe": "^22.2.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.18",
    "vaul": "^1.1.2",
    "zod": "4.6.7",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@modelcontextprotocol/ext-apps": "2.0.4",
    "@cloudflare/workers-oauth-provider": "1.2.4",
    "agents": "0.33.0",
    "@xyflow/react": "12.12.1",
    "elkjs": "0.12.1",
    "@modelcontextprotocol/server": "2.4.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/core": "2.4.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.10",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "latest",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22.19.19",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@typescript-eslint/parser": "^8.60.0",
    "@vitejs/plugin-react": "^6.0.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.4.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.5",
    "wrangler": "^4.95.0",
    "esbuild": "^0.28.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "lightningcss",
      "sharp",
      "workerd"
    ]
  },
  "version": "0.1.0",
  "engines": {
    "node": ">=22.12.0"
  }
}
